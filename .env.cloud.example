HEXOSTUDIO_MODE=cloud
HEXOSTUDIO_DATABASE_URL=postgresql://username:password@database.example/hexostudio?sslmode=require
HEXOSTUDIO_ORIGIN=https://studio.example.com
# Multiple production domains: comma-separated exact HTTPS origins, no wildcards.
# HEXOSTUDIO_ORIGIN=https://studio.example.com,https://your-project.vercel.app
# Generate these independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
HEXOSTUDIO_SECRET=
HEXOSTUDIO_SETUP_KEY=
# Optional MongoDB database name override; otherwise the URI must include it.
# HEXOSTUDIO_DATABASE_NAME=hexostudio
