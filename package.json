{
  "name": "hexostudio",
  "version": "0.8.0",
  "private": true,
  "description": "A local web and desktop studio for Hexo blogs",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "web": "node server/index.cjs",
    "desktop": "electron .",
    "check": "node scripts/check.cjs",
    "test": "node --test",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "markdown-it": "14.3.3",
    "mongodb": "^6.21.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.hexostudio.app",
    "productName": "HexoStudio",
    "files": [
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    }
  }
}
