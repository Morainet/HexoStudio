{
  "name": "@morainet/hexostudio",
  "version": "1.0.0",
  "description": "A local, cloud and desktop studio for Hexo blogs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morainet/HexoStudio.git"
  },
  "homepage": "https://github.com/Morainet/HexoStudio#readme",
  "bugs": "https://github.com/Morainet/HexoStudio/issues",
  "keywords": [
    "hexo",
    "blog",
    "cms",
    "markdown",
    "cli"
  ],
  "main": "server/index.cjs",
  "bin": {
    "hs": "bin/hs.cjs"
  },
  "files": [
    "bin/",
    "server/",
    "public/",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preview:assets": "node scripts/prepare-preview-assets.cjs",
    "web": "node bin/hs.cjs start",
    "start": "node bin/hs.cjs start",
    "desktop": "electron desktop/main.cjs",
    "icons": "node scripts/generate-icons.cjs",
    "oem:prepare": "node scripts/prepare-oem.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test",
    "test:package": "node scripts/verify-package.cjs",
    "prepublishOnly": "npm run check && npm test && npm run test:package && npm audit --audit-level=high",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "markdown-it": "14.3.3",
    "mongodb": "^6.21.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "socks": "^2.8.10",
    "sql.js": "^1.15.1",
    "undici": "^7.30.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "mermaid": "^12.2.0"
  },
  "build": {
    "appId": "dev.hexostudio.app",
    "productName": "HexoStudio",
    "extraMetadata": {
      "desktopAppId": "dev.hexostudio.app",
      "main": "desktop/main.cjs"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "identity": "-",
      "icon": "desktop/icons/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "desktop/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "desktop/icons/icon.ico",
      "uninstallerIcon": "desktop/icons/icon.ico",
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    }
  }
}
